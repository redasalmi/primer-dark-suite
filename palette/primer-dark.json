      "green": "#3FB950",
      "yellow": "#D29922",
      "blue": "#58A6FF",
      "magenta": "#BE8FFF",
      "cyan": "#39C5CF",
      "white": "#F0F6FC",
      "brightBlack": "#656C76",
      "brightRed": "#FFA198",
      "brightGreen": "#56D364",
      "brightYellow": "#E3B341",
