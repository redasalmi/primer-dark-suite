{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "auto",
        "padding": {
            "top": 0,
            "left": 0,
            "right": 4
        },
        "color": {
            "1": "#1F6FEB",
            "2": "#F0F6FC",
            "3": "#3FB950",
            "4": "#D29922",
            "5": "#4493F8",
            "6": "#39C5CF",
            "7": "#AB7DF8",
            "8": "#DB6D28",
            "9": "#F85149"
        }
    },
    "display": {
        "separator": ": ",
        "color": {
            "keys": "#9198A1",
            "title": "#4493F8",
            "output": "#F0F6FC",
            "separator": "#3D444D"
        },
        "brightColor": false,
        "percent": {
            "type": [
                "num",
                "num-color"
            ],
            "color": {
                "green": "#3FB950",
                "yellow": "#D29922",
                "red": "#F85149"
            }
        },
        "temp": {
            "color": {
                "green": "#3FB950",
                "yellow": "#D29922",
                "red": "#F85149"
            }
        },
        "bar": {
            "color": {
                "elapsed": "auto",
                "total": "#212830",
                "border": "#3D444D"
            }
        }
    },
    "modules": [
        {
            "type": "title",
            "color": {
                "user": "#F0F6FC",
                "at": "#656C76",
                "host": "#4493F8"
            }
        },
        "separator",
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "display",
        "de",
        "wm",
        "wmtheme",
        "theme",
        "icons",
        "font",
        "cursor",
        "terminal",
        "terminalfont",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "localip",
        "battery",
        "poweradapter",
        "locale",
        "break",
        "colors"
    ]
}
