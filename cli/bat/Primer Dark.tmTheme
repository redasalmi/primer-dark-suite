<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Primer Dark for bat
  SPDX-License-Identifier: MIT
  Colors derive from palette/primer-dark.json.
  bat uses this file name as the theme name, so install it as "Primer Dark.tmTheme".
-->
<plist version="1.0">
    <dict>
        <key>name</key>
        <string>Primer Dark</string>
        <key>author</key>
        <string>Primer Dark Suite</string>
        <key>colorSpaceName</key>
        <string>sRGB</string>
        <key>semanticClass</key>
        <string>theme.dark.primer-dark</string>
        <key>settings</key>
        <array>
            <dict>
                <key>settings</key>
                <dict>
                    <key>background</key>
                    <string>#0D1117</string>
                    <key>foreground</key>
                    <string>#F0F6FC</string>
                    <key>caret</key>
                    <string>#4493F8</string>
                    <key>lineHighlight</key>
                    <string>#151B23</string>
                    <key>selection</key>
                    <string>#1F6FEB</string>
                    <key>selectionForeground</key>
                    <string>#FFFFFF</string>
                    <key>inactiveSelection</key>
                    <string>#212830</string>
                    <key>findHighlight</key>
                    <string>#D29922</string>
                    <key>findHighlightForeground</key>
                    <string>#0D1117</string>
                    <key>gutter</key>
                    <string>#010409</string>
                    <key>gutterForeground</key>
                    <string>#656C76</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>Comments</string>
                <key>scope</key>
                <string>comment, punctuation.definition.comment</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#9198A1</string>
                    <key>fontStyle</key>
                    <string>italic</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>Keywords</string>
                <key>scope</key>
                <string>keyword, storage, storage.type, storage.modifier, keyword.control, keyword.other.special-method</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#FF7B72</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>Operators</string>
                <key>scope</key>
                <string>keyword.operator, punctuation.definition.keyword</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#FF7B72</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>Functions</string>
                <key>scope</key>
                <string>entity.name.function, meta.require, support.function, support.function.any-method, meta.function-call, meta.function-call.generic</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#D2A8FF</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>Labels</string>
                <key>scope</key>
