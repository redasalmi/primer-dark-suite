                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#FFA657</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>Classes and Types</string>
                <key>scope</key>
                <string>support.class, entity.name.class, entity.name.type, entity.name.type.class, entity.other.inherited-class, support.type, support.other.namespace, entity.name.namespace</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#FFA657</string>
