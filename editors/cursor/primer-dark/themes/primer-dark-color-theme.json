  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": {
        "foreground": "#9198A1"
      }
    },
    {
      "name": "Constant and enum member",
      "scope": [
        "constant",
        "entity.name.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "variable.language",
        "entity"
      ],
      "settings": {
        "foreground": "#79C0FF"
      }
    },
    {
      "name": "String and embedded expression",
      "scope": ["string", "string punctuation.section.embedded source"],
      "settings": {
        "foreground": "#A5D6FF"
      }
    },
    {
      "name": "Number and boolean literal",
      "scope": ["constant.numeric", "constant.language", "constant.language.boolean"],
      "settings": {
        "foreground": "#79C0FF"
      }
    },
    {
      "name": "Placeholder and character constant",
      "scope": ["constant.other.placeholder", "constant.character"],
      "settings": {
        "foreground": "#79C0FF"
      }
    },
    {
      "name": "Escape sequence",
      "scope": ["constant.character.escape", "string.regexp constant.character.escape"],
      "settings": {
        "foreground": "#FF7B72"
      }
    },
    {
      "name": "Keyword and storage",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "keyword.operator.new",
        "keyword.operator.expression",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#FF7B72"
      }
    },
    {
      "name": "Storage modifier import and package",
      "scope": [
        "storage.modifier.package",
        "storage.modifier.import",
        "storage.type.java",
        "keyword.other.using",
        "keyword.other.directive.using",
        "keyword.other.operator"
      ],
      "settings": {
        "foreground": "#F0F6FC"
      }
    },
    {
      "name": "Function and constructor",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "meta.definition.method"
      ],
      "settings": {
        "foreground": "#D2A8FF"
      }
    },
    {
      "name": "Type and class",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.namespace",
        "entity.name.scope-resolution",
        "entity.other.inherited-class",
        "support.class",
        "support.type",
        "support.constant.math",
        "support.constant.dom",
        "support.constant.json"
      ],
      "settings": {
        "foreground": "#FFA657"
      }
    },
    {
      "name": "Enum and variant",
      "scope": [
        "entity.name.type.enum",
        "entity.name.type.variant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#FFA657"
      }
    },
    {
      "name": "Tag and JSX component",
      "scope": ["entity.name.tag", "support.class.component", "punctuation.definition.tag"],
      "settings": {
        "foreground": "#7EE787"
      }
    },
    {
      "name": "Attribute and decorator",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute",
        "meta.decorator",
        "punctuation.definition.decorator",
        "meta.annotation"
      ],
      "settings": {
        "foreground": "#79C0FF"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.parameter.function",
        "meta.definition.variable.name",
        "support.variable",
        "entity.name.variable"
      ],
      "settings": {
        "foreground": "#F0F6FC"
      }
    },
    {
      "name": "Function parameter",
      "scope": ["variable.parameter", "meta.function.parameters"],
      "settings": {
        "foreground": "#FFA657"
      }
    },
    {
      "name": "Property and object key",
      "scope": ["meta.object-literal.key", "support.type.property-name", "meta.property-name"],
      "settings": {
        "foreground": "#79C0FF"
      }
    },
    {
      "name": "Punctuation and brackets",
      "scope": [
        "punctuation",
        "punctuation.definition.bracket",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#F0F6FC"
      }
    },
    {
      "name": "Regular expression",
      "scope": ["source.regexp", "string.regexp", "string.regexp.character-class"],
      "settings": {
        "foreground": "#A5D6FF"
      }
    },
    {
      "name": "Link and markup underlining",
      "scope": [
        "constant.other.reference.link",
        "string.other.link",
        "markup.underline.link",
        "markup.underline.link.image"
      ],
      "settings": {
        "foreground": "#79C0FF"
      }
    },
    {
      "name": "Markdown emphasis and strong",
      "scope": ["markup.italic", "markup.bold"],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown heading",
      "scope": ["markup.heading", "entity.name.section"],
      "settings": {
        "foreground": "#79C0FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown quote",
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#9198A1",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown raw and code block",
      "scope": ["markup.raw", "markup.raw.block", "markup.inline.raw"],
      "settings": {
        "foreground": "#A5D6FF"
      }
    },
    {
      "name": "Markdown list marker",
      "scope": ["punctuation.definition.list.begin.markdown"],
      "settings": {
        "foreground": "#FFA657"
      }
    },
    {
      "name": "Diff inserted",
      "scope": ["markup.inserted", "meta.diff.header.to-file"],
      "settings": {
        "foreground": "#3FB950"
      }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted", "meta.diff.header.from-file"],
      "settings": {
        "foreground": "#F85149"
      }
    },
    {
      "name": "Diff changed and range",
      "scope": ["markup.changed", "meta.diff.range"],
      "settings": {
        "foreground": "#D29922"
      }
    },
    {
      "name": "Diff header and separator",
      "scope": ["meta.diff.header", "meta.separator"],
      "settings": {
        "foreground": "#9198A1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.broken", "invalid.deprecated", "invalid.illegal", "invalid.unimplemented"],
      "settings": {
        "foreground": "#F85149"
      }
    },
    {
      "name": "Error message",
      "scope": ["message.error"],
      "settings": {
        "foreground": "#F85149"
      }
    },
    {
      "name": "Carriage return control character",
      "scope": "carriage-return",
      "settings": {
        "background": "#FF7B72",
        "foreground": "#0D1117",
        "fontStyle": "italic underline"
      }
    }
  ]
}
