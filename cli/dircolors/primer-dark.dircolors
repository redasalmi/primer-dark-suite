SETUID 38;2;240;246;252;48;2;73;2;2
SETGID 38;2;240;246;252;48;2;52;26;0
CAPABILITY 38;2;240;246;252;48;2;73;2;2
STICKY_OTHER_WRITABLE 38;2;240;246;252;48;2;4;38;15
OTHER_WRITABLE 38;2;68;147;248;48;2;4;38;15
STICKY 38;2;240;246;252;48;2;5;29;77
EXEC 01;38;2;63;185;80

