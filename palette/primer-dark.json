    "foreground": {
      "default": "#F0F6FC",
      "muted": "#9198A1",
      "subtle": "#B7BDC8",
      "disabled": "#656C76",
      "onEmphasis": "#FFFFFF"
    },
    "border": {
      "default": "#3D444D",
      "subtle": "#2F3742",
