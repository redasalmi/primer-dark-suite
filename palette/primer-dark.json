{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Primer Dark",
  "source": "https://github.com/primer/primitives",
  "tokens": {
    "surface": {
      "inset": "#010409",
      "default": "#0D1117",
      "muted": "#151B23",
      "raised": "#212830",
      "control": "#262C36",
      "accentInset": "#051D4D",
      "successInset": "#04260F",
      "attentionInset": "#341A00",
      "dangerInset": "#490202",
      "accentMuted": "#111D2E",
      "successMuted": "#12261E",
      "attentionMuted": "#272215",
      "dangerMuted": "#25181C"
